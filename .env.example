# Supabase project settings (Supabase dashboard -> Project Settings -> API,
# or the output of `npx supabase status` when running Supabase locally).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Direct Postgres connection used by drizzle-kit (migrations) and the seed script.
# Supabase dashboard -> Connect -> "Direct connection" or "Session pooler".
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
